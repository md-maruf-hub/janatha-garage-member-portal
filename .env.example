# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# Application Public Host URL (Used for generating ID card links in email notifications)
NEXT_PUBLIC_APP_URL="https://janatha-garage-member-portal.vercel.app"

# GOOGLE APPS SCRIPT WEB APP URL (For Google Sheets sync & storage backend)
NEXT_PUBLIC_GAS_WEB_APP_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
VITE_GAS_WEB_APP_URL=""

# Admin Authentication & Security
ADMIN_USER="admin"
ADMIN_PASSWORD="CHANGE_THIS_IN_PRODUCTION_PASSWORD"
API_SECRET_KEY="CHANGE_THIS_SERVER_API_KEY"

# SMTP Email Configuration (For approval & rejection notification emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"Janatha Garage Admin" <your-email@gmail.com>'

